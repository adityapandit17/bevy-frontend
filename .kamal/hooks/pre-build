#!/bin/bash
# Kamal pre-build hook — blocks deploy if Next.js / React packages are vulnerable.
#
# Runs automatically before `kamal deploy` builds the Docker image.
# Manual check:  yarn deploy:check
# Skip registry: KAMAL_SKIP_REGISTRY_CHECK=1 kamal deploy

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"

cd "$APP_ROOT"

if [ ! -d "node_modules" ]; then
  if [ -f "yarn.lock" ]; then
    echo "node_modules missing — running yarn --frozen-lockfile..." >&2
    yarn --frozen-lockfile
  elif [ -f "package-lock.json" ]; then
    echo "node_modules missing — running npm ci..." >&2
    npm ci
  else
    echo "node_modules missing and no lockfile found (yarn.lock/package-lock.json)." >&2
    exit 1
  fi
fi

if [ -f "package-lock.json" ] && [ ! -d "node_modules" ]; then
  echo "node_modules missing — running npm ci..." >&2
  npm ci
fi

node "$HOOK_DIR/lib/check-deploy-security.mjs"
